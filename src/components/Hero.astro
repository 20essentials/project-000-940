<section class='hero'>
  <h1>PAGINATION WITH ASTRO</h1>
  <a href=`${Astro.site}/gallery/1` class='button'>Explore Images</a>
</section>

<script>
  import { $ } from '@/utils/functions';
  const $hero = $('.hero');
  function spark(event: MouseEvent) {
    const { clientX, clientY } = event;
    const element = document.createElement('i');
    element.classList.add('spark');
    element.style.left = `${clientX}px`;
    element.style.top = `${clientY}px`;
    element.style.scale = `${Math.random() * 2 + 1}`;
    element.style.setProperty('--x', getRandomPosition());
    element.style.setProperty('--y', getRandomPosition());

    setTimeout(() => element.remove(), 2000);

    function getRandomPosition() {
      return `${Math.random() * 400 - 200}px`;
    }

    $hero?.appendChild(element);
  }

  document.addEventListener('mousemove', spark);
</script>

