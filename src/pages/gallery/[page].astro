---
import AmAnchor from '@/components/AmAnchor.astro';
import Card from '@/components/Card.astro';
import Layout from '@/layouts/Layout.astro';
import type { GetStaticPaths, Page } from 'astro';

interface Gallery {
  image: string;
}

export const getStaticPaths: GetStaticPaths = ({ paginate }) => {
  const arrayPages: Gallery[] = Array.from({ length: 28 }, (_, i) => {
    return {
      image: `${Astro.site}/assets/j${i + 1}.avif`,
      titleImage: `/assets/j${i + 1}.avif`
    };
  });

  return paginate(arrayPages, { pageSize: 4 });
};

const { page } = Astro.props;
const { currentPage, data, url } = page as Page;
const { first, last, next, prev } = url;
---

<Layout title={`Gallery Page #${currentPage}`}>
  <section class='container'>
    {
      data.map(({ image, titleImage }, i) => {
        return <Card image={image} titleImage={titleImage} alt={`Image ${i + 1}`} />;
      })
    }
    <nav class='container-buttons'>
      {!first && <AmAnchor href={last} type='prev' />}
      {prev && <AmAnchor href={prev} type='prev' />}
      {next && <AmAnchor href={next} type='next' />}
      {!last && <AmAnchor href={first} type='next' />}
    </nav>
  </section>
</Layout>

<style>
  .container {
    width: 100%;
    height: 100vh;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(15vmax, 1fr));
    place-content: center;
    gap: 3.4vmax;
    padding: 5vmax;
    position: relative;
  }

  .container-buttons {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
    width: 80%;
    bottom: 1vmax;
    display: flex;
    justify-content: center;
    gap: 1vmax;

    @media (width <= 1111px) and (orientation: portrait) {
      bottom: 12vmax;
    }
  }
</style>
